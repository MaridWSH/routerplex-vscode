{
  "name": "routerplex-hackathon",
  "displayName": "RouterPlex Hackathon",
  "description": "Join your team with one code, track credit, and configure VS Code Chat, Codex, OpenCode, Claude Code, and Claude Desktop.",
  "version": "1.4.3",
  "publisher": "routerplex",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaridWSH/routerplex-vscode.git"
  },
  "homepage": "https://github.com/MaridWSH/routerplex-vscode/tree/hackathon#readme",
  "bugs": {
    "url": "https://github.com/MaridWSH/routerplex-vscode/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "routerplex",
    "hackathon",
    "codex",
    "opencode",
    "claude",
    "openai",
    "language models"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "routerplex-hackathon",
        "displayName": "RouterPlex Hackathon",
        "managementCommand": "routerplexHackathon.openPanel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "routerplexHackathon",
          "title": "Hackathon",
          "icon": "media/routerplex.svg"
        }
      ]
    },
    "views": {
      "routerplexHackathon": [
        {
          "id": "routerplexHackathon.controlPanel",
          "name": "Control Panel",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "routerplexHackathon.openPanel",
        "title": "Hackathon: Open Control Panel",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.setup",
        "title": "Hackathon: Set Up VS Code and Codex",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.join",
        "title": "Hackathon: Join With a Team Code",
        "category": "Hackathon",
        "icon": "$(rocket)"
      },
      {
        "command": "routerplexHackathon.manageConnection",
        "title": "Hackathon: Manage Connection",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.configureCodex",
        "title": "Hackathon: Configure Codex",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.configureOpenCode",
        "title": "Hackathon: Configure OpenCode",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.configureClaude",
        "title": "Hackathon: Configure Claude Desktop and Claude Code",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.testConnection",
        "title": "Hackathon: Test Connection",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.refreshModels",
        "title": "Hackathon: Refresh Models",
        "category": "Hackathon",
        "icon": "$(refresh)"
      },
      {
        "command": "routerplexHackathon.refresh",
        "title": "Hackathon: Refresh Credit",
        "category": "Hackathon",
        "icon": "$(sync)"
      },
      {
        "command": "routerplexHackathon.copyKey",
        "title": "Hackathon: Copy API Key",
        "category": "Hackathon",
        "icon": "$(key)"
      },
      {
        "command": "routerplexHackathon.openChat",
        "title": "Hackathon: Open the Chat View",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.checkForUpdates",
        "title": "Hackathon: Check for Updates",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.openCodexConfig",
        "title": "Hackathon: Open Codex Configuration",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.openSettings",
        "title": "Hackathon: Open Settings",
        "category": "Hackathon",
        "icon": "$(settings)"
      },
      {
        "command": "routerplexHackathon.signOut",
        "title": "Hackathon: Sign Out",
        "category": "Hackathon"
      },
      {
        "command": "routerplexHackathon.configureCodexModel",
        "title": "Hackathon: Use Model for Codex",
        "category": "Hackathon"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "routerplexHackathon.configureCodexModel",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "routerplexHackathon.refresh",
          "when": "view == routerplexHackathon.controlPanel",
          "group": "navigation@1"
        },
        {
          "command": "routerplexHackathon.copyKey",
          "when": "view == routerplexHackathon.controlPanel",
          "group": "navigation@2"
        },
        {
          "command": "routerplexHackathon.openSettings",
          "when": "view == routerplexHackathon.controlPanel",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "RouterPlex Hackathon",
      "properties": {
        "routerplexHackathon.consoleUrl": {
          "type": "string",
          "default": "https://hackathon.routerplex.com",
          "scope": "machine",
          "description": "Hackathon console that issues team keys and reports credit."
        },
        "routerplexHackathon.catalogUrl": {
          "type": "string",
          "default": "https://routerplex.com/api/models",
          "scope": "machine",
          "description": "Public model catalog used to describe the hackathon models. Only models your team was granted are ever shown."
        },
        "routerplexHackathon.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Codex home directory. Leave empty to use CODEX_HOME or ~/.codex."
        },
        "routerplexHackathon.shellProfile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional shell profile used to export ROUTERPLEX_HACKATHON_API_KEY. Leave empty to detect bash, zsh, fish, or ~/.profile."
        },
        "routerplexHackathon.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Automatically install newer hackathon builds from GitHub and prompt to reload VS Code."
        },
        "routerplexHackathon.updateCheckIntervalHours": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 168,
          "scope": "machine",
          "description": "Hours between automatic checks for new hackathon releases."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "node scripts/esbuild.mjs",
    "build": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
